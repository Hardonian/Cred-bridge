generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Tenant { id String @id name String region String program String learners Int allocation Int used Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt ledgerEntries CreditLedgerEntry credentials IssuedCredential }
model CreditPool { id String @id poolSize Int contractCents Int termStart DateTime termEnd DateTime warningThreshold Float escalationThreshold Float hardReserveThreshold Float createdAt DateTime @default(now()) }
model CreditLedgerEntry { id String @id tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) idempotencyKey String @unique kind String credits Int status String reference String createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model Learner { id String @id tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) externalRefHash String credentials IssuedCredential evidence MilestoneEvidence createdAt DateTime @default(now()) @@unique([tenantId,externalRefHash]) }
model MilestoneEvidence { id String @id learnerId String learner Learner @relation(fields:[learnerId],references:[id]) achievementId String payloadHash String approvedAt DateTime? createdAt DateTime @default(now()) @@index([learnerId,achievementId]) }
model IssuedCredential { id String @id learnerId String learner Learner @relation(fields:[learnerId],references:[id]) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) type String status String payload Json externalId String? issuedAt DateTime? revokedAt DateTime? createdAt DateTime @default(now()) @@index([tenantId,status]) }
model AuditEvent { id String @id tenantId String action String actorId String targetType String targetId String metadata Json createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model RevocationRecord { id String @id credentialId String reason String revokedAt DateTime @default(now()) }
